{
	"name": "leaflet.markercluster",
	"version": "1.5.4",
	"description": "Provides Beautiful Animated Marker Clustering functionality for Leaflet",
	"homepage": "https://github.com/Leaflet/Leaflet.markercluster",
	"keywords": [
		"gis",
		"map",
		"cluster",
		"leaflet",
		"plugin"
	],
	"repository": {
		"type": "git",
		"url": "git://github.com/Leaflet/Leaflet.markercluster.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./src/index.js"
		},
		"./dist/*.css": "./dist/*.css"
	},
	"types": "./dist/types/index.d.ts",
	"style": "dist/MarkerCluster.css",
	"files": [
		"src",
		"dist"
	],
	"sideEffects": [
		"*.css",
		"./src/MarkerPatches.js"
	],
	"peerDependencies": {
		"leaflet": "^1.9.0 || ^2.0.0-beta.1"
	},
	"scripts": {
		"lint": "eslint",
		"test": "npm run lint && npm run test:types && vitest run",
		"test:types": "npm run build:types && tsc -p test/types",
		"build": "rolldown --config build/rolldown-config.js && npm run build:types",
		"build:types": "tsc && cp src/MarkerPatches.d.ts dist/types/",
		"prepublishOnly": "npm run build"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-mourner": "^5.0.2",
		"eslint-plugin-baseline-js": "^0.7.7",
		"eslint-plugin-html": "^8.2.1",
		"leaflet": "^2.0.0-beta.1",
		"leaflet-v1": "npm:leaflet@^1.9.4",
		"playwright": "^1.64.1",
		"rolldown": "^1.2.16",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
